#!/usr/bin/env bash
set -uo pipefail

# ---------------------------------------------------------------------------
# 1984dns — CLI for 1984.is FreeDNS zone management
# One-liner DNS record operations from the terminal.
#
# Configuration: ~/.config/1984dns/config or environment variables
#
#   DNS1984_USER=you@example.com
#   DNS1984_PASS=yourpassword
# ---------------------------------------------------------------------------

VERSION="1.0.0"
COOKIE_FILE="${HOME}/.cache/1984dns/cookies.txt"
ZONE_CACHE="${HOME}/.cache/1984dns/zones.cache"
CONFIG_FILE="${HOME}/.config/1984dns/config"
BASE_URL="https://1984.is"

# ---------------------------------------------------------------------------
# Load config (file first, env overrides)
# ---------------------------------------------------------------------------
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

USER="${DNS1984_USER:-}"
PASS="${DNS1984_PASS:-}"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
mkdir -p "$(dirname "$COOKIE_FILE")"

die() { echo "error: $*" >&2; exit 1; }

check_creds() {
  [[ -z "$USER" ]] && die "DNS1984_USER not set. Export it or add to ${CONFIG_FILE}"
  [[ -z "$PASS" ]] && die "DNS1984_PASS not set. Export it or add to ${CONFIG_FILE}"
}

ensure_login() {
  check_creds

  # Reuse session if still valid
  if [[ -f "$COOKIE_FILE" ]]; then
    local check
    check=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/api/auth/" 2>/dev/null || echo '{}')
    if grep -q '"ok": true' <<< "$check"; then
      return 0
    fi
  fi

  # Fresh login
  local login_page csrf
  login_page=$(curl -s -c "$COOKIE_FILE" "${BASE_URL}/login/")
  csrf=$(grep -oP 'csrfmiddlewaretoken" value="\K[^"]+' <<< "$login_page" || true)
  [[ -z "$csrf" ]] && die "Could not get CSRF token from 1984.is"

  local result
  result=$(curl -s \
    -b "$COOKIE_FILE" \
    -c "$COOKIE_FILE" \
    -X POST "${BASE_URL}/api/auth/" \
    -H "Referer: ${BASE_URL}/login/" \
    -H "X-CSRFToken: ${csrf}" \
    -H "X-Requested-With: XMLHttpRequest" \
    --data-urlencode "username=${USER}" --data-urlencode "password=${PASS}" --data-urlencode "otpkey=${DNS1984_OTP:-}")

  if ! grep -q '"loggedin": true' <<< "$result"; then
    die "Login failed. Check your credentials."
  fi
}

get_csrf() {
  grep -oP 'csrftoken\s+\K\S+' "$COOKIE_FILE" | tail -1
}

# ---------------------------------------------------------------------------
# Zone discovery — auto-discovers zones from your account
# ---------------------------------------------------------------------------
discover_zones() {
  ensure_login
  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/")
  local zone_ids
  zone_ids=$(grep -oP '/domains/zone/(\d+)/' <<< "$html" | grep -oP '\d+' | sort -u)

  mkdir -p "$(dirname "$ZONE_CACHE")"
  > "$ZONE_CACHE"

  for zid in $zone_ids; do
    local zhtml zone_name
    zhtml=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/zone/${zid}/")
    zone_name=$(grep -oP 'id="zone" value="\K[^"]*' <<< "$zhtml" || true)
    if [[ -n "$zone_name" ]]; then
      echo "${zone_name}=${zid}" >> "$ZONE_CACHE"
    fi
  done
}

resolve_zone() {
  local zone="$1"

  # Build cache if missing
  if [[ ! -f "$ZONE_CACHE" ]]; then
    discover_zones >&2
  fi

  # Exact match
  local zid
  zid=$(grep -P "^${zone}=" "$ZONE_CACHE" 2>/dev/null | cut -d= -f2 | head -1)
  if [[ -n "$zid" ]]; then echo "$zid"; return; fi

  # Partial match
  zid=$(grep -iP "${zone}" "$ZONE_CACHE" 2>/dev/null | head -1 | cut -d= -f2)
  if [[ -n "$zid" ]]; then echo "$zid"; return; fi

  die "Unknown zone: ${zone}. Run '1984dns zones --refresh' to refresh."
}

# ---------------------------------------------------------------------------
# Parse zone page → structured records
# ---------------------------------------------------------------------------
parse_zone() {
  local html="$1"
  local entries
  entries=$(grep -oP 'entry_(\d+)' <<< "$html" | sed 's/entry_//' | sort -un)

  printf "%-10s %-6s %-35s %-6s %-5s %s\n" "ENTRY_ID" "TYPE" "HOST" "TTL" "PRI" "VALUE"
  printf "%-10s %-6s %-35s %-6s %-5s %s\n" "--------" "----" "----" "---" "---" "-----"

  for eid in $entries; do
    local type host rdata ttl pri
    type=$(grep -oP "type_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    [[ -z "$type" ]] && continue
    host=$(grep -oP "host_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    rdata=$(grep -oP "rdata_${eid}\"[^>]*value='\K[^']*" <<< "$html" 2>/dev/null || true)
    ttl=$(grep -oP "ttl_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    pri=$(grep -oP "priority_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    rdata=$(echo "$rdata" | sed 's/&quot;/"/g; s/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g')
    printf "%-10s %-6s %-35s %-6s %-5s %s\n" "$eid" "$type" "$host" "${ttl:-3600}" "${pri:--}" "$rdata"
  done
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_zones() {
  if [[ ! -f "$ZONE_CACHE" ]] || [[ "${1:-}" == "--refresh" ]]; then
    discover_zones
  fi
  echo "Zones on account:"
  while IFS='=' read -r name zid; do
    printf "  %-25s zone_id=%s\n" "$name" "$zid"
  done < "$ZONE_CACHE"
}

cmd_list() {
  local zone="${1:-}"
  [[ -z "$zone" ]] && die "Usage: 1984dns list <zone>"
  local zid
  zid=$(resolve_zone "$zone")
  ensure_login

  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/zone/${zid}/")
  local zone_name
  zone_name=$(grep -oP 'id="zone" value="\K[^"]*' <<< "$html")
  echo "=== ${zone_name} (zone ${zid}) ==="
  echo
  parse_zone "$html"
}

cmd_get() {
  local zone="$1" host="$2" type="${3:-}"
  local zid
  zid=$(resolve_zone "$zone")
  ensure_login

  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/zone/${zid}/")
  local entries
  entries=$(grep -oP 'entry_(\d+)' <<< "$html" | sed 's/entry_//' | sort -un)

  for eid in $entries; do
    local etype ehost erdata ettl epri
    etype=$(grep -oP "type_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    ehost=$(grep -oP "host_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    [[ -z "$etype" ]] && continue
    if [[ "$ehost" == "$host" ]]; then
      if [[ -z "$type" || "$etype" == "$type" ]]; then
        erdata=$(grep -oP "rdata_${eid}\"[^>]*value='\K[^']*" <<< "$html" 2>/dev/null || true)
        erdata=$(echo "$erdata" | sed 's/&quot;/"/g; s/&amp;/\&/g')
        ettl=$(grep -oP "ttl_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
        epri=$(grep -oP "priority_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
        printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$eid" "$etype" "$ehost" "${ettl:-3600}" "${epri:--}" "$erdata"
      fi
    fi
  done
}

# Find an entry's ID in a zone page by matching type + host. Echoes id or "".
find_entry_id() {
  local html="$1" type="$2" host="$3"
  local entries
  entries=$(grep -oP 'entry_(\d+)' <<< "$html" | sed 's/entry_//' | sort -un)
  for eid in $entries; do
    local etype ehost
    etype=$(grep -oP "type_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    ehost=$(grep -oP "host_${eid}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    if [[ "$etype" == "$type" && "$ehost" == "$host" ]]; then
      echo "$eid"; return 0
    fi
  done
  return 0
}

cmd_set() {
  local zone="$1" type="$2" host="$3" rdata="$4" ttl="${5:-3600}" pri="${6:-0}"
  local zid
  zid=$(resolve_zone "$zone")
  ensure_login

  # SRV records use separate weight/port/target fields (1984.is form contract:
  # priority + weight + port + target). Pass value as "weight port target".
  # Every field is URL-encoded: a bare "+" (base64 in DKIM keys) would otherwise arrive as a space.
  local srv_fields=()
  if [[ "${type^^}" == "SRV" ]]; then
    local s_weight s_port s_target
    read -r s_weight s_port s_target <<< "$rdata"
    [[ -z "$s_weight" || -z "$s_port" || -z "$s_target" ]] && \
      die "SRV needs: 1984dns set <zone> SRV <_svc._proto> \"<weight> <port> <target.>\" [ttl] [priority]"
    rdata="$s_target"
    srv_fields=(--data-urlencode "weight=${s_weight}" --data-urlencode "port=${s_port}" --data-urlencode "target=${s_target}")
  fi

  # Check if entry already exists (same type + host → update)
  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/zone/${zid}/")
  local existing_id
  existing_id=$(find_entry_id "$html" "$type" "$host")

  local entry_id="${existing_id:-new}"
  local csrf
  csrf=$(get_csrf)
  local zone_name
  zone_name=$(grep -oP 'id="zone" value="\K[^"]*' <<< "$html")

  local result
  result=$(curl -s \
    -b "$COOKIE_FILE" \
    -c "$COOKIE_FILE" \
    -X POST "${BASE_URL}/domains/entry/" \
    -H "Referer: ${BASE_URL}/domains/zone/${zid}/" \
    -H "X-CSRFToken: ${csrf}" \
    -H "X-Requested-With: XMLHttpRequest" \
    --data-urlencode "entry=${entry_id}" --data-urlencode "zone=${zone_name}" --data-urlencode "type=${type}" \
    --data-urlencode "host=${host}" --data-urlencode "ttl=${ttl}" --data-urlencode "priority=${pri}" \
    --data-urlencode "rdata=${rdata}" "${srv_fields[@]}")

  if grep -qP '"ok":\s*true' <<< "$result"; then
    if [[ -n "$existing_id" ]]; then
      echo "updated ${host}.${zone_name} ${type} → ${rdata} (entry ${existing_id})"
    else
      # Create response omits the new ID — re-read the zone and match type+host.
      local new_id
      new_id=$(echo "$result" | grep -oP '"entry":\s*\K\d+' || true)
      [[ -z "$new_id" ]] && new_id=$(find_entry_id "$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/zone/${zid}/")" "$type" "$host")
      echo "created ${host}.${zone_name} ${type} → ${rdata} (entry ${new_id:-?})"
    fi
  else
    local errtxt
    errtxt=$(echo "$result" | grep -oP '"errortxt":\s*"\K[^"]*' || echo "$result")
    die "failed: ${errtxt}"
  fi
}

cmd_del() {
  local zone="$1" entry_id="$2"
  local zid
  zid=$(resolve_zone "$zone")
  ensure_login

  local csrf
  csrf=$(get_csrf)

  local result
  result=$(curl -s \
    -b "$COOKIE_FILE" \
    -c "$COOKIE_FILE" \
    -X POST "${BASE_URL}/domains/delentry/" \
    -H "Referer: ${BASE_URL}/domains/zone/${zid}/" \
    -H "X-CSRFToken: ${csrf}" \
    -H "X-Requested-With: XMLHttpRequest" \
    -d "entry=${entry_id}")

  if grep -q '"ok"' <<< "$result"; then
    echo "deleted entry ${entry_id}"
  else
    die "delete failed: $result"
  fi
}

cmd_point() {
  local zone="$1" host="$2" ip="$3"
  cmd_set "$zone" "A" "$host" "$ip" 3600
}

cmd_mx() {
  local zone="$1" host="$2" value="$3" pri="${4:-10}"
  cmd_set "$zone" "MX" "$host" "$value" 3600 "$pri"
}

cmd_txt() {
  local zone="$1" host="$2" value="$3"
  cmd_set "$zone" "TXT" "$host" "$value" 3600
}

# Verify a record is live on the zone's authoritative nameservers (post-write
# propagation check — 1984.is rebuilds zones on a delay after web/API edits).
cmd_verify() {
  local zone="$1" host="$2" type="${3:-A}"
  [[ -z "$zone" || -z "$host" ]] && die "Usage: 1984dns verify <zone> <host> [type]"
  command -v dig >/dev/null || die "dig not found (install dnsutils/bind-tools)"

  local fqdn
  if [[ "$host" == "@" ]]; then fqdn="$zone"; else fqdn="${host}.${zone}"; fi

  # Authoritative nameservers for the zone (public delegation).
  local nslist
  nslist=$(dig +short NS "$zone" 2>/dev/null | sed 's/\.$//' | sort)
  [[ -z "$nslist" ]] && die "no NS records found for ${zone} (is it delegated?)"

  echo "=== verify ${type} ${fqdn} across authoritative NS ==="
  local seen_any=0
  for ns in $nslist; do
    local answer
    answer=$(dig +short "@${ns}" "$fqdn" "$type" 2>/dev/null | paste -sd' ' -)
    if [[ -n "$answer" ]]; then
      printf "  ✓ %-28s %s\n" "$ns" "$answer"; seen_any=1
    else
      printf "  ✗ %-28s (no answer)\n" "$ns"
    fi
  done
  [[ "$seen_any" == 0 ]] && echo "  → not yet propagated to any authoritative server"
}

# ---------------------------------------------------------------------------
# Nameserver management (registrar-level NS delegation)
# ---------------------------------------------------------------------------
resolve_configure_id() {
  local domain="$1"
  ensure_login
  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/domains/")
  # Find configure link — there may be one shared page or per-domain
  local cfg_id
  cfg_id=$(grep -oP '/configure/(\d+)/' <<< "$html" | grep -oP '\d+' | head -1)
  [[ -z "$cfg_id" ]] && die "Could not find configure page"
  echo "$cfg_id"
}

cmd_ns() {
  local domain="${1:-}"
  [[ -z "$domain" ]] && die "Usage: 1984dns ns <domain>"
  ensure_login

  local cfg_id
  cfg_id=$(resolve_configure_id "$domain")

  local html
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/configure/${cfg_id}/")

  # Check if this domain is on this configure page
  local page_domain
  page_domain=$(grep -oP 'name="domain" value="\K[^"]*' <<< "$html" | head -1)

  echo "=== Nameservers for ${page_domain:-$domain} ==="
  for i in 1 2 3 4 5; do
    local ns
    ns=$(grep -oP "nameserver${i}\"[^>]*value=\"\K[^\"]*" <<< "$html" 2>/dev/null || true)
    [[ -n "$ns" ]] && printf "  NS%d: %s\n" "$i" "$ns"
  done
}

cmd_ns_set() {
  local domain="$1"
  shift
  local ns1="${1:-}" ns2="${2:-}" ns3="${3:-}" ns4="${4:-}" ns5="${5:-}"

  [[ -z "$domain" ]] && die "Usage: 1984dns ns-set <domain> <ns1> [ns2] [ns3] [ns4] [ns5]"
  [[ -z "$ns1" ]] && die "At least one nameserver required"

  ensure_login

  local cfg_id
  cfg_id=$(resolve_configure_id "$domain")

  local html csrf
  html=$(curl -s -b "$COOKIE_FILE" "${BASE_URL}/configure/${cfg_id}/")
  csrf=$(grep -oP 'csrfmiddlewaretoken" value="\K[^"]+' <<< "$html" | head -1)
  [[ -z "$csrf" ]] && csrf=$(get_csrf)

  echo "Changing nameservers for ${domain}:"
  [[ -n "$ns1" ]] && echo "  NS1: $ns1"
  [[ -n "$ns2" ]] && echo "  NS2: $ns2"
  [[ -n "$ns3" ]] && echo "  NS3: $ns3"
  [[ -n "$ns4" ]] && echo "  NS4: $ns4"
  [[ -n "$ns5" ]] && echo "  NS5: $ns5"

  local result
  result=$(curl -s \
    -b "$COOKIE_FILE" \
    -c "$COOKIE_FILE" \
    -X POST "${BASE_URL}/domains/changenameservers/" \
    -H "Referer: ${BASE_URL}/configure/${cfg_id}/" \
    -H "X-CSRFToken: ${csrf}" \
    -H "X-Requested-With: XMLHttpRequest" \
    -d "csrfmiddlewaretoken=${csrf}&domain=${domain}&nameserver1=${ns1}&nameserver2=${ns2}&nameserver3=${ns3}&nameserver4=${ns4}&nameserver5=${ns5}")

  if echo "$result" | grep -q '"mainerror"'; then
    local err
    err=$(echo "$result" | grep -oP '"mainerror":\s*"\K[^"]*' || echo "$result")
    die "NS change failed: $err"
  fi

  # Parse per-nameserver results
  echo ""
  for i in 1 2 3 4 5; do
    local check msg
    check=$(echo "$result" | grep -oP "\"nameserver${i}\":\s*\{\"check\":\s*\K(true|false)" || true)
    msg=$(echo "$result" | grep -oP "\"nameserver${i}\":\s*\{[^}]*\"msg\":\s*\"\K[^\"]*" || true)
    [[ -z "$check" ]] && continue
    if [[ "$check" == "true" ]]; then
      printf "  NS%d: ✓ %s\n" "$i" "${msg:-ok}"
    else
      printf "  NS%d: ✗ %s\n" "$i" "${msg:-failed}"
    fi
  done
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
CMD="${1:-help}"
shift || true

case "$CMD" in
  zones)         cmd_zones "$@" ;;
  list|ls)       cmd_list "$@" ;;
  get)           [[ $# -lt 2 ]] && die "Usage: 1984dns get <zone> <host> [type]"; cmd_get "$@" ;;
  set|add|update) [[ $# -lt 4 ]] && die "Usage: 1984dns set <zone> <type> <host> <value> [ttl] [pri]"; cmd_set "$@" ;;
  del|delete|rm) [[ $# -lt 2 ]] && die "Usage: 1984dns del <zone> <entry_id>"; cmd_del "$@" ;;
  point)         [[ $# -lt 3 ]] && die "Usage: 1984dns point <zone> <host> <ip>"; cmd_point "$@" ;;
  mx)            [[ $# -lt 3 ]] && die "Usage: 1984dns mx <zone> <host> <value> [pri]"; cmd_mx "$@" ;;
  txt)           [[ $# -lt 3 ]] && die "Usage: 1984dns txt <zone> <host> <value>"; cmd_txt "$@" ;;
  verify|check)  [[ $# -lt 2 ]] && die "Usage: 1984dns verify <zone> <host> [type]"; cmd_verify "$@" ;;
  ns)            [[ $# -lt 1 ]] && die "Usage: 1984dns ns <domain>"; cmd_ns "$@" ;;
  ns-set)        [[ $# -lt 2 ]] && die "Usage: 1984dns ns-set <domain> <ns1> [ns2] [ns3] [ns4] [ns5]"; cmd_ns_set "$@" ;;
  version|--version|-v) echo "1984dns ${VERSION}" ;;
  help|--help|-h)
    cat <<'HELP'
1984dns — CLI for 1984.is FreeDNS zone management

Usage:
  1984dns zones [--refresh]                                List all zones
  1984dns list <zone>                                      List all records
  1984dns get <zone> <host> [type]                         Get specific record(s)
  1984dns set <zone> <type> <host> <value> [ttl] [pri]     Create or update
  1984dns del <zone> <entry_id>                            Delete by entry ID
  1984dns point <zone> <host> <ip>                         Quick A record
  1984dns mx <zone> <host> <value> [pri]                   Set MX record
  1984dns txt <zone> <host> <value>                        Set TXT record
  1984dns verify <zone> <host> [type]                      Check record is live on authoritative NS
  1984dns ns <domain>                                      Show current nameservers
  1984dns ns-set <domain> <ns1> [ns2] [ns3] [ns4] [ns5]   Change nameserver delegation

Config: DNS1984_USER and DNS1984_PASS via environment or ~/.config/1984dns/config

Examples:
  1984dns point example.is www 1.2.3.4
  1984dns set example.is A @ 1.2.3.4
  1984dns set example.is MX @ mail.example.is. 3600 10
  1984dns set example.is SRV _imaps._tcp "1 993 mail.example.is." 3600 0   # value = "weight port target"
  1984dns txt example.is _dmarc '"v=DMARC1; p=reject"'
  1984dns list example.is
  1984dns del example.is 12345
  1984dns ns olibuijr.com
  1984dns ns-set olibuijr.com ns1.olibuijr.com ns2.olibuijr.com
HELP
    ;;
  *) die "Unknown command: $CMD (try: 1984dns help)" ;;
esac
